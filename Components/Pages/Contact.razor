@page "/contact"
@rendermode InteractiveServer

<PageTitle>Contact | Slow Burn Roasters</PageTitle>

<section class="mx-auto max-w-6xl px-5 pt-10">
    <p class="eyebrow">Get in touch &middot; Roastery counter</p>
    <h1 class="mt-2 text-4xl font-bold sm:text-5xl">Contact the roaster</h1>
    <p class="mt-3 max-w-xl text-muted">
        Questions about origin lots, grind settings, or wholesale beans? Send us a note or stop by the tasting counter.
    </p>
</section>

<div class="mx-auto mt-8 grid max-w-6xl gap-8 px-5 lg:grid-cols-[1fr_1.2fr] lg:items-start">
    <div class="space-y-6">
        <div class="panel bg-kraft p-6 shadow-block">
            <span class="stamp">Roastery counter</span>
            <h2 class="mt-4 font-display text-2xl font-bold">Visit in person</h2>
            <p class="mt-2 text-sm text-muted">
                Our roastery and espresso bar are open five days a week. Whole bean bags and filter gear are available for counter pickup.
            </p>

            <dl class="mt-5 space-y-3 divide-y-2 divide-dashed divide-ink/30 border-y-2 border-ink text-sm">
                <div class="pt-3">
                    <dt class="font-mono text-[11px] uppercase tracking-widest text-muted">Hours</dt>
                    <dd class="mt-1 font-bold">Tuesday to Saturday &middot; 8:00 to 17:00</dd>
                    <dd class="text-xs text-muted">Closed Sunday & Monday (drum roast days)</dd>
                </div>
                <div class="pt-3">
                    <dt class="font-mono text-[11px] uppercase tracking-widest text-muted">Address</dt>
                    <dd class="mt-1 font-bold">74 Foundry Lane, Mill District</dd>
                    <dd class="text-xs text-muted">Counter collection entrance at Bay 3</dd>
                </div>
                <div class="pt-3">
                    <dt class="font-mono text-[11px] uppercase tracking-widest text-muted">Dispatch & Support</dt>
                    <dd class="mt-1 font-bold">hello@slowburnroasters.com</dd>
                    <dd class="font-mono text-xs text-muted">+1 (555) 482-9011</dd>
                </div>
            </dl>
        </div>

        <div class="panel border-dashed p-5 text-sm">
            <p class="font-bold">Roasting schedule notice</p>
            <p class="mt-1 text-muted">
                All single-origin lots are roasted in five-kilo drums every Monday. Mail orders placed before Monday 23:59 dispatch Tuesday via tracked courier.
            </p>
        </div>
    </div>

    <div>
        @if (sent)
        {
            <div class="panel bg-kraft p-8 shadow-block" role="status">
                <span class="stamp">Sent</span>
                <h2 class="mt-4 text-3xl font-bold">Thanks for reaching out!</h2>
                <p class="mt-2 text-muted">
                    We've received your note, <strong class="text-ink">@lastSubmittedName</strong>. The team will reply to <strong class="text-ink">@lastSubmittedEmail</strong> before the next roast batch.
                </p>
                <div class="mt-6 flex flex-wrap gap-3">
                    <button type="button" class="btn" @onclick="SendAnother">Send another message</button>
                    <a href="/shop" class="btn-ghost">Browse coffee</a>
                </div>
            </div>
        }
        else
        {
            <div class="panel p-6 sm:p-8">
                <h2 class="font-display text-2xl font-bold">Send a message</h2>
                <p class="mt-1 text-sm text-muted">We reply within 24 hours on roasting days.</p>

                <EditForm Model="form" OnValidSubmit="HandleSubmit" class="mt-6 space-y-5" novalidate>
                    <DataAnnotationsValidator />

                    <div>
                        <label for="contact-name" class="field-label">Your Name</label>
                        <InputText id="contact-name" class="field" placeholder="e.g. Jane Doe" @bind-Value="form.Name" />
                        <ValidationMessage For="() => form.Name" />
                    </div>

                    <div>
                        <label for="contact-email" class="field-label">Email Address</label>
                        <InputText id="contact-email" type="email" class="field" placeholder="you@domain.com" @bind-Value="form.Email" />
                        <ValidationMessage For="() => form.Email" />
                    </div>

                    <div>
                        <label for="contact-message" class="field-label">Message</label>
                        <InputTextArea id="contact-message" rows="5" class="field" placeholder="Tell us what's on your mind (minimum 10 characters)..." @bind-Value="form.Message" />
                        <ValidationMessage For="() => form.Message" />
                    </div>

                    <button type="submit" class="btn w-full sm:w-auto" disabled="@submitting">
                        @if (submitting)
                        {
                            <span class="size-4 animate-spin border-2 border-paper border-t-transparent" aria-hidden="true"></span>
                        }
                        @(submitting ? "Sending..." : "Send message")
                    </button>
                </EditForm>
            </div>
        }
    </div>
</div>

@code {
    private ContactForm form = new();
    private bool submitting;
    private bool sent;
    private string lastSubmittedName = "";
    private string lastSubmittedEmail = "";

    private async Task HandleSubmit()
    {
        if (submitting) return;
        submitting = true;
        await Task.Delay(800); // Simulate network dispatch

        lastSubmittedName = form.Name;
        lastSubmittedEmail = form.Email;
        sent = true;
        submitting = false;
        form = new ContactForm();
    }

    private void SendAnother()
    {
        sent = false;
        form = new ContactForm();
    }
}

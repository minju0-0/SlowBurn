@page "/admin/products"
@rendermode InteractiveServer
@inject IProductService Products

<PageTitle>Admin Products | Slow Burn Roasters</PageTitle>

<section class="mx-auto max-w-6xl px-5 pt-10">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b-2 border-ink pb-4">
        <div>
            <p class="eyebrow">Inventory Management &middot; Class Admin</p>
            <h1 class="mt-1 text-3xl font-bold sm:text-4xl">Product catalogue admin</h1>
        </div>
        <a href="/shop" class="btn-ghost">View public shop</a>
    </div>
</section>

<div class="mx-auto mt-8 max-w-6xl space-y-8 px-5 pb-16">
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="border-l-4 border-ok bg-kraft px-4 py-3 font-mono text-xs" role="status">
            @statusMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="border-l-4 border-signal bg-kraft px-4 py-3 font-mono text-xs text-signal" role="alert">
            @errorMessage
        </div>
    }

    <!-- Add Product Form -->
    <section class="panel p-6 sm:p-8" aria-labelledby="add-title">
        <h2 id="add-title" class="font-display text-2xl font-bold">Add new product</h2>
        <p class="mt-1 text-sm text-muted">Create a new catalogue item saved directly to Supabase.</p>

        <form @onsubmit="HandleAdd" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:items-end">
            <div>
                <label for="new-name" class="field-label">Product Name</label>
                <input id="new-name" type="text" class="field" placeholder="e.g. Yirgacheffe Washed" @bind="newName" required />
            </div>

            <div>
                <label for="new-sku" class="field-label">SKU</label>
                <input id="new-sku" type="text" class="field" placeholder="e.g. SB-099" @bind="newSku" required />
            </div>

            <div>
                <label for="new-category" class="field-label">Category</label>
                <select id="new-category" class="field" @bind="newCategory">
                    @foreach (var c in Enum.GetValues<ProductCategory>())
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>

            <div>
                <label for="new-price" class="field-label">Price ($)</label>
                <input id="new-price" type="number" step="0.50" min="0" class="field" @bind="newPrice" required />
            </div>

            <div>
                <label for="new-stock" class="field-label">Stock</label>
                <input id="new-stock" type="number" min="0" class="field" @bind="newStock" required />
            </div>

            <div class="sm:col-span-2 lg:col-span-5 flex justify-end">
                <button type="submit" class="btn" disabled="@savingAdd">
                    @if (savingAdd)
                    {
                        <span class="size-4 animate-spin border-2 border-paper border-t-transparent" aria-hidden="true"></span>
                    }
                    @(savingAdd ? "Adding..." : "Add product")
                </button>
            </div>
        </form>
    </section>

    <!-- Product Table / Management List -->
    <section class="panel p-6 sm:p-8" aria-labelledby="list-title">
        <div class="flex items-center justify-between pb-4">
            <h2 id="list-title" class="font-display text-2xl font-bold">
                Existing active products (@items.Count)
            </h2>
            <button type="button" class="btn-ghost" @onclick="LoadProductsAsync" disabled="@loading">
                @(loading ? "Refreshing..." : "Refresh")
            </button>
        </div>

        @if (loading && items.Count == 0)
        {
            <p class="py-8 text-center text-muted">Loading products from Supabase...</p>
        }
        else if (items.Count == 0)
        {
            <p class="py-8 text-center text-muted">No active products found in the database.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b-2 border-ink font-mono text-xs uppercase tracking-wider text-muted">
                            <th class="py-3 px-2">ID</th>
                            <th class="py-3 px-2">SKU</th>
                            <th class="py-3 px-2">Name</th>
                            <th class="py-3 px-2">Category</th>
                            <th class="py-3 px-2 w-28">Price ($)</th>
                            <th class="py-3 px-2 w-24">Stock</th>
                            <th class="py-3 px-2 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink/20">
                        @foreach (var p in items)
                        {
                            var rowId = p.Id;
                            <tr class="hover:bg-kraft/40">
                                <td class="py-3 px-2 font-mono text-xs text-muted">@p.Id</td>
                                <td class="py-3 px-2 font-mono font-bold">@p.Sku</td>
                                <td class="py-3 px-2 font-bold">@p.Name</td>
                                <td class="py-3 px-2"><span class="tag">@p.Category</span></td>
                                <td class="py-3 px-2">
                                    <input type="number" step="0.50" min="0" class="field py-1 px-2 text-sm"
                                           value="@GetRowPrice(p)"
                                           @onchange="e => SetRowPrice(p, e.Value)" />
                                </td>
                                <td class="py-3 px-2">
                                    <input type="number" min="0" class="field py-1 px-2 text-sm"
                                           value="@GetRowStock(p)"
                                           @onchange="e => SetRowStock(p, e.Value)" />
                                </td>
                                <td class="py-3 px-2 text-right space-x-2">
                                    <button type="button" class="btn py-1 px-3 text-xs"
                                            disabled="@IsRowSaving(rowId)"
                                            @onclick="() => HandleSaveRow(p)">
                                        @(IsRowSaving(rowId) ? "Saving..." : "Save")
                                    </button>
                                    <button type="button" class="btn-ghost py-1 px-3 text-xs text-signal border-signal/40 hover:bg-signal hover:text-paper"
                                            disabled="@IsRowSaving(rowId)"
                                            @onclick="() => HandleDelete(p)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private List<Product> items = new();
    private Dictionary<int, decimal> editPrices = new();
    private Dictionary<int, int> editStocks = new();
    private HashSet<int> savingRowIds = new();

    private string newName = "";
    private string newSku = "";
    private ProductCategory newCategory = ProductCategory.Beans;
    private decimal newPrice = 18.00m;
    private int newStock = 20;

    private bool loading;
    private bool savingAdd;
    private string? statusMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            items = await Products.GetFilteredAsync(null, null, null, null);
            editPrices.Clear();
            editStocks.Clear();
            foreach (var p in items)
            {
                editPrices[p.Id] = p.Price;
                editStocks[p.Id] = p.Stock;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load products: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private decimal GetRowPrice(Product p) =>
        editPrices.TryGetValue(p.Id, out var v) ? v : p.Price;

    private void SetRowPrice(Product p, object? val)
    {
        if (decimal.TryParse(val?.ToString(), out var parsed))
            editPrices[p.Id] = parsed;
    }

    private int GetRowStock(Product p) =>
        editStocks.TryGetValue(p.Id, out var v) ? v : p.Stock;

    private void SetRowStock(Product p, object? val)
    {
        if (int.TryParse(val?.ToString(), out var parsed))
            editStocks[p.Id] = parsed;
    }

    private bool IsRowSaving(int id) => savingRowIds.Contains(id);

    private async Task HandleAdd()
    {
        if (savingAdd) return;
        if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newSku))
        {
            errorMessage = "Please enter both product name and SKU.";
            return;
        }

        savingAdd = true;
        errorMessage = null;
        statusMessage = null;

        try
        {
            var p = new Product
            {
                Name = newName.Trim(),
                Sku = newSku.Trim().ToUpperInvariant(),
                Category = newCategory,
                Price = newPrice,
                Stock = newStock,
                Art = newCategory == ProductCategory.Beans ? "bag" : (newCategory == ProductCategory.Gear ? "cone" : "box"),
                Tone = "#7b2d12"
            };

            await Products.CreateAsync(p);
            statusMessage = $"Added \"{p.Name}\" ({p.Sku}) to catalogue in Supabase.";
            newName = "";
            newSku = "";
            newPrice = 18.00m;
            newStock = 20;

            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating product: {ex.Message}";
        }
        finally
        {
            savingAdd = false;
        }
    }

    private async Task HandleSaveRow(Product p)
    {
        if (savingRowIds.Contains(p.Id)) return;
        savingRowIds.Add(p.Id);
        errorMessage = null;
        statusMessage = null;

        try
        {
            var updatedPrice = editPrices.TryGetValue(p.Id, out var pr) ? pr : p.Price;
            var updatedStock = editStocks.TryGetValue(p.Id, out var st) ? st : p.Stock;

            await Products.UpdateAsync(p.Id, updatedPrice, updatedStock);
            p.Price = updatedPrice;
            p.Stock = updatedStock;
            statusMessage = $"Updated \"{p.Name}\" &rarr; Price: ${updatedPrice:F2}, Stock: {updatedStock}.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating \"{p.Name}\": {ex.Message}";
        }
        finally
        {
            savingRowIds.Remove(p.Id);
        }
    }

    private async Task HandleDelete(Product p)
    {
        if (savingRowIds.Contains(p.Id)) return;
        savingRowIds.Add(p.Id);
        errorMessage = null;
        statusMessage = null;

        try
        {
            await Products.SoftDeleteAsync(p.Id);
            statusMessage = $"Soft-deleted \"{p.Name}\" from catalogue (deleted_at recorded).";
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting \"{p.Name}\": {ex.Message}";
        }
        finally
        {
            savingRowIds.Remove(p.Id);
        }
    }
}

